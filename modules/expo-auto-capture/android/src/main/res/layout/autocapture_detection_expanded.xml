<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 14 M2: expanded face of the rich detection alert. Carries the full
  transaction details (merchant, formatted amount, source app, detected time)
  with the Confirm, Edit, and Remind later actions rendered as system action
  buttons by the builder (DecoratedCustomViewStyle keeps the OS chrome: app
  name, header, expand affordance). Same theming rules as the collapsed face:
  OS theme text colors, packaged Manrope, sp sizes, dp padding, fluid widths. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingStart="16dp"
  android:paddingEnd="16dp"
  android:paddingTop="12dp"
  android:paddingBottom="12dp">

  <TextView
    android:id="@+id/detection_heading"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/manrope_semibold"
    android:textSize="12sp"
    android:textColor="?android:attr/textColorSecondary"
    android:singleLine="true" />

  <TextView
    android:id="@+id/detection_amount"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:fontFamily="@font/manrope_semibold"
    android:textSize="22sp"
    android:textColor="?android:attr/textColorPrimary"
    android:singleLine="true" />

  <TextView
    android:id="@+id/detection_merchant"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:fontFamily="@font/manrope_semibold"
    android:textSize="14sp"
    android:textColor="?android:attr/textColorPrimary"
    android:singleLine="true"
    android:ellipsize="end" />

  <TextView
    android:id="@+id/detection_source"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:fontFamily="@font/manrope_regular"
    android:textSize="12sp"
    android:textColor="?android:attr/textColorSecondary"
    android:singleLine="true"
    android:ellipsize="end" />
</LinearLayout>
